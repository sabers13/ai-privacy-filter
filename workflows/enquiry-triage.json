      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/data/out/{{ $('Build result').first().json.id }}.json",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "5f0a2b70-0d1a-4a6e-9e1e-1c9f0e6b7a0d",
      "name": "Write result",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2280,
        -160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const enquiry = $('Enquiry webhook').first().json.body;\nconst gate = $('Triage via gate').first().json;\nconst id = String(enquiry.id || '');\nif (!/^[A-Za-z0-9._-]+$/.test(id)) {\n  throw new Error('enquiry id must match [A-Za-z0-9._-]+');\n}\nreturn [{ json: {\n  id,\n  status: gate.statusCode === 422 ? 'blocked' : 'gate_error',\n  gate_status: gate.statusCode,\n  leaked_types: (gate.body && gate.body.detail && gate.body.detail.leaked_types) || [],\n} }];"
      },
      "id": "5f0a2b70-0d1a-4a6e-9e1e-1c9f0e6b7a0e",
      "name": "Prepare blocked record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
