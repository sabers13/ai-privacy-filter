        "options": {
          "format": true
        }
      },
      "id": "5f0a2b70-0d1a-4a6e-9e1e-1c9f0e6b7a0c",
      "name": "Convert result",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.2,
      "position": [
